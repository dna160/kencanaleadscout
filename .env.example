# ---- Server ----
# Injected by Railway in production. Locally defaults to 8080.
PORT=8080

# ---- Scraper tunables (Part A) ----
CONCURRENCY=10
REQUEST_TIMEOUT_MS=12000
MAX_PAGES_PER_SITE=4
# Max upload size in bytes (default 15MB).
MAX_UPLOAD_BYTES=15728640

# ---- Database (Part B) ----
# Injected by the Railway Postgres plugin in production.
# Local example (matches docker-compose.yml):
DATABASE_URL=postgres://kencana:kencana@localhost:5432/leadscout

# ---- Logging ----
# info | debug | warn | error
LOG_LEVEL=info

# ---- Selaras ERP mirror (Stock 2.0) ----
# ERP REST base URL. LEAVE EMPTY TO DISABLE THE ERP INTEGRATION: the sync worker
# never starts and every stock surface renders "ERP tidak terhubung" instead of
# failing. The app boots either way.
SELARAS_BASE_URL=https://erp.selaras.example.com/api/v1
# Bearer token. SECRET — never logged, never returned in a response. Leave empty
# locally; injected as an environment variable in production.
# Selaras issues a KEY + TOKEN pair — a single bearer credential cannot
# authenticate against it. Placement (header vs query) is config, not code.
SELARAS_AUTH_MODE=header
SELARAS_KEY_PARAM=secret_key
SELARAS_TOKEN_PARAM=secret_token
SELARAS_SECRET_KEY=
SELARAS_SECRET_TOKEN=
# Legacy single-credential mode only (SELARAS_AUTH_MODE=bearer).
SELARAS_TOKEN=
# Per-request timeout against the ERP, in ms.
SELARAS_TIMEOUT_MS=20000
# How to read a numeric that arrives as a STRING. JSON numbers are unaffected.
#   auto (default) — REFUSE an ambiguous string loudly rather than guess it.
#                    "1.234" is 1234 in Indonesian notation and 1.234 in English
#                    notation; "0.350" is a real thickness of 0.35 that the
#                    Indonesian rule would read as 350. A refused value becomes
#                    NULL (or 0 for qty / qty_balance), is counted, and is logged
#                    once per table per run. Refusing reserves nothing; guessing
#                    can be wrong by a factor of 1000, silently.
#   id             — dot = thousands, comma = decimal, last separator wins.
#                    This is how PPIC's own Excel is parsed today (PRD §8.4).
#   en             — comma = thousands, dot = decimal.
# Set this to id or en once a real Selaras response body has been inspected; if
# the sync log starts reporting refusals, that log line names the values to check.
SELARAS_NUMBER_FORMAT=auto

# ---- Stock 2.0 tunables ----
# Sync cadence in ms (3 min; the ERP pull is incremental by updated_at).
STOCK_SYNC_INTERVAL_MS=180000
# Rows per page requested from the ERP.
STOCK_SYNC_PAGE_SIZE=1000
# Liveness window in days: an approved SO line whose estimate_delivery is older
# than this stops reserving stock and moves to the stale review queue (ST-R17).
STOCK_STALE_WINDOW_DAYS=60
# CSV of status_order values that mean the line is dead and reserves nothing.
STOCK_CANCELLED_STATUSES=Cancelled,Void,Batal
# Show the stale-data banner after this many missed sync intervals (ST-R7).
STOCK_SYNC_STALE_ALERT_INTERVALS=4
# Shadow mode: compute ATP but do not make it authoritative yet (ST-R16).
STOCK_ATP_SHADOW=false
# Canonical SKU key composition (ST-R5.1/ST-R5.2). CSV, order matters; valid
# names: kode_barang, warna, th, p, l. Changing this changes every sku_key —
# re-run the sync so the mirror is recomputed.
STOCK_SKU_KEY_SEGMENTS=kode_barang,warna,th,p,l
