# ---- Server ----
# Injected by Railway in production. Locally defaults to 8080.
PORT=8080

# ---- Scraper tunables (Part A) ----
CONCURRENCY=10
REQUEST_TIMEOUT_MS=12000
MAX_PAGES_PER_SITE=4
# Max upload size in bytes (default 15MB).
MAX_UPLOAD_BYTES=15728640

# ---- Database (Part B) ----
# Injected by the Railway Postgres plugin in production.
# Local example (matches docker-compose.yml):
DATABASE_URL=postgres://kencana:kencana@localhost:5432/leadscout

# ---- Logging ----
# info | debug | warn | error
LOG_LEVEL=info

# ---- Selaras ERP mirror (Stock 2.0) ----
# ERP REST base URL. LEAVE EMPTY TO DISABLE THE ERP INTEGRATION: the sync worker
# never starts and every stock surface renders "ERP tidak terhubung" instead of
# failing. The app boots either way.
# VERIFIED 2026-09-11: the API root is https://selaras2.io/kencana/api — the
# /api suffix belongs in this variable. Rows come from <base>/table/{table},
# the table list from <base>/tables, a schema from <base>/table/{table}/columns.
# NOT https://selaras2.io/kencana/table_documentation — that is the human-facing
# documentation page, and pointing this at it 404s every request.
SELARAS_BASE_URL=https://selaras2.io/kencana/api
# Selaras issues a KEY + TOKEN pair — a single bearer credential cannot
# authenticate against it. Placement (header vs query) is config, not code, and
# the two placements use DIFFERENT names (verified): headers are X-Secret-Key /
# X-Secret-Token, query params are secret_key / secret_token. Both SECRET —
# never logged, never returned in a response.
SELARAS_AUTH_MODE=header
SELARAS_KEY_HEADER=x-secret-key
SELARAS_TOKEN_HEADER=x-secret-token
SELARAS_KEY_PARAM=secret_key
SELARAS_TOKEN_PARAM=secret_token
SELARAS_SECRET_KEY=
SELARAS_SECRET_TOKEN=
# Legacy single-credential mode only (SELARAS_AUTH_MODE=bearer).
SELARAS_TOKEN=
# Per-request timeout against the ERP, in ms.
SELARAS_TIMEOUT_MS=20000
# How to read a numeric that arrives as a STRING. JSON numbers are unaffected.
#   auto (default) — REFUSE an ambiguous string loudly rather than guess it.
#                    "1.234" is 1234 in Indonesian notation and 1.234 in English
#                    notation; "0.350" is a real thickness of 0.35 that the
#                    Indonesian rule would read as 350. A refused value becomes
#                    NULL (or 0 for qty / qty_balance), is counted, and is logged
#                    once per table per run. Refusing reserves nothing; guessing
#                    can be wrong by a factor of 1000, silently.
#   id             — dot = thousands, comma = decimal, last separator wins.
#                    This is how PPIC's own Excel is parsed today (PRD §8.4).
#   en             — comma = thousands, dot = decimal.
# Set this to id or en once a real Selaras response body has been inspected; if
# the sync log starts reporting refusals, that log line names the values to check.
SELARAS_NUMBER_FORMAT=auto

# ---- Stock 2.0 tunables ----
# Sync cadence in ms (3 min; the ERP pull is incremental by updated_at).
STOCK_SYNC_INTERVAL_MS=180000
# Rows per page requested from the ERP.
STOCK_SYNC_PAGE_SIZE=1000
# Safety lookback subtracted from the stored cursor on every incremental pull,
# in minutes. 12 hours, and the size is the point: it must comfortably exceed the
# SEVEN-hour WIB (UTC+7) offset. The documented datetime grammar is
# `YYYY-MM-DD HH:mm:ss` in WIB, which is what the client now sends; if the ERP
# were ever to read an offset-bearing timestamp and discard the offset, the
# cursor would land 7 hours ahead and skip rows that no later run would revisit.
# Re-fetching costs nothing — every write is an idempotent upsert by primary key.
STOCK_SYNC_LOOKBACK_MINUTES=720
# Liveness window in days: an approved SO line whose estimate_delivery is older
# than this stops reserving stock and moves to the stale review queue (ST-R17).
STOCK_STALE_WINDOW_DAYS=60
# CSV of status_order values that mean the line is dead and reserves nothing.
STOCK_CANCELLED_STATUSES=Cancelled,Void,Batal
# Show the stale-data banner after this many missed sync intervals (ST-R7).
STOCK_SYNC_STALE_ALERT_INTERVALS=4
# Shadow mode: compute ATP but do not make it authoritative yet (ST-R16).
STOCK_ATP_SHADOW=false
# Canonical SKU key composition (ST-R5.1/ST-R5.2). CSV, order matters; valid
# names: brand, warna, th (aluminium skin), th_panel (total panel), p, l — the
# ERP's own spellings (th_alu_skin, total_thickness_acp, t) are accepted too.
# Changing this changes every sku_key — reset the cursors and re-run the sync so
# the mirror is recomputed, or the old rows keep their retired key forever.
#
# v1 was kode_barang,warna,th,p,l. The verified column list for the SO detail
# table has NEITHER kode_barang NOR th, so that key matched nothing at all: every
# commitment fell to the exceptions tray, open_commitment was 0 for every SKU,
# and the whole inventory read as promiseable.
STOCK_SKU_KEY_SEGMENTS=brand,warna,th,th_panel,p,l
# ST-R5.2 safety net. After a sync, if there are live commitments and MORE THAN
# this fraction of them match no stock row at all, one loud error is logged
# naming the unmatched share, example keys from both sides, and the knob above.
# The key composition is verified against the ERP's documented columns but has
# never been run against real rows, and the failure is silent: unmatched demand
# reserves nothing, so ATP equals on-hand and everything reads as promiseable.
STOCK_UNMATCHED_ALERT_RATIO=0.5
